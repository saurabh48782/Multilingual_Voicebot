#  Postgres (checkpointer + chat_sessions metadata)
# docker-compose hardcodes test_user/test_password/voicebot for the `db`
# service (dev-only, non-secret) - kept here so bare-metal runs (uv run
# uvicorn/alembic, no compose) can reach the same container.
POSTGRES_DB=voicebot
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password

# DSN the app/Alembic use to reach Postgres.
#   docker compose : host is `db`      (api/integration-test set this themselves)
#   bare metal      : host is 127.0.0.1 (compose publishes the DB on 127.0.0.1:5433)
CHECKPOINT_DSN=postgresql://test_user:test_password@127.0.0.1:5433/voicebot  # pragma: allowlist secret

# Sidecar URLs (REQUIRED at runtime; compose sets these automatically)
# Bare-metal only - leave blank/unset under docker compose (it injects them).
STT_REMOTE_URL=http://localhost:8002
TTS_REMOTE_URL=http://localhost:8001

# Hugging Face (model downloads in the sidecars)
HF_TOKEN=

#  API server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

#  API hardening
# When set, all /api/* routes require this value in an X-API-Key header.
# Unset = OPEN (dev only; a startup warning is logged).
VOICEBOT_API_KEY=
RATE_LIMIT_PER_MINUTE=120
# Trust the left-most X-Forwarded-For hop (set to 1 behind a proxy/compose net).
RATE_LIMIT_TRUST_FORWARDED=0
# Comma-separated CORS origins; unset = same-origin only.
CORS_ALLOW_ORIGINS=
MAX_REQUEST_BYTES=52428800

# Langsmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voicebot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
